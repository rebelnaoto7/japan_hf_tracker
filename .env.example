# Copy to .env (local) or set as App Settings on Azure.
# All values have safe development defaults in settings.py.

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# "True" for local dev, "False" in production.
DJANGO_DEBUG=True

# Comma-separated hostnames (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins for CSRF (e.g. https://myapp.azurewebsites.net)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Timezone (default Asia/Tokyo).
DJANGO_TIME_ZONE=Asia/Tokyo
DJANGO_USE_TZ=True

# Optional: managed database (PostgreSQL). If unset, SQLite is used.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
